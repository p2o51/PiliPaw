<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 霹雳啵: the animated mark (drawable/splash_icon, 1000 ms) ends on ic_launcher_foreground.
         The duration is read by Android 12 / 12L; 13+ takes it from the drawable. -->
    <style name="Theme.PiliPala.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">@integer/splash_icon_duration</item>
        <item name="postSplashScreenTheme">@style/Theme.PiliPala</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
