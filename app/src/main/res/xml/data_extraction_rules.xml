<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: neither the cloud backup nor a device-to-device transfer carries the login
     (cookies, account) or the device identity (buvid in pili_net). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="pili_cookies.xml" />
        <exclude domain="sharedpref" path="pili_account.xml" />
        <exclude domain="sharedpref" path="pili_net.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pili_cookies.xml" />
        <exclude domain="sharedpref" path="pili_account.xml" />
        <exclude domain="sharedpref" path="pili_net.xml" />
    </device-transfer>
</data-extraction-rules>
